  {
   "id": "ID_SYNTH_CLASS_FEATURE_KINDLE",
   "name": "Kindle",
   "type": "Class Feature",
   "source": "Synthetic Test Source",
   "description": "<p>You carry embers equal to 1 + your Constitution modifier (minimum 1). Creatures you scorch make a Constitution save (DC 8 + proficiency + Constitution).</p>",
   "rules": [
    {
     "kind": "resource",
     "id": "embers",
     "name": "Embers",
     "max": {
      "type": "formula",
      "expr": "max(1, 1 + constitution:modifier)"
     },
     "recharge": [
      "long_rest"
     ]
    },
    {
     "kind": "save_dc",
     "id": "kindle",
     "formula": "8+proficiency+constitution"
    }
   ]
  },
