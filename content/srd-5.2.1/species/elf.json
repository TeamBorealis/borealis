     "mode": "always_prepared",
     "free_cast": {
      "uses": 1,
      "recharge": "long_rest"
     },
     "also_with_slots": true,
     "ability": {
      "param": "Lineage Spellcasting Ability"
     }
    }
   ],
   "data": {
    "lineage": "Wood Elf",
    "level_1_text": "Your Speed increases to 35 feet. You also know the Druidcraft cantrip.",
    "level_3_spell": "Longstrider",
    "level_5_spell": "Pass without Trace",
    "level_1_cantrips": [
