     }
    },
    {
     "kind": "grant_spell",
     "level": 3,
     "spell": "ID_2024_SPELL_LONGSTRIDER",
     "mode": "always_prepared",
     "free_cast": {
      "uses": 1,
      "recharge": "long_rest"
     },
     "also_with_slots": true,
     "ability": {
      "param": "Lineage Spellcasting Ability"
     }
    },
    {
