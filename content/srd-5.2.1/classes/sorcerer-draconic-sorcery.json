    },
    {
     "kind": "grant_spell",
     "level": 3,
     "spell": "ID_2024_SPELL_DRAGONS_BREATH",
     "mode": "always_prepared",
     "counts_against_prepared": false,
     "spell_list": "Sorcerer"
    },
    {
     "kind": "grant_spell",
     "level": 5,
     "spell": "ID_2024_SPELL_FEAR",
     "mode": "always_prepared",
     "counts_against_prepared": false,
