     "type": "Archetype Feature",
     "level": 10
    },
    {
     "kind": "grant",
     "id": "ID_2024_SUBCLASS_FEATURE_DRUID_CIRCLE_OF_THE_LAND_NATURES_SANCTUARY",
     "type": "Archetype Feature",
     "level": 14
    }
   ],
