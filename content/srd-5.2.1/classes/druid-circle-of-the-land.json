    {
     "kind": "grant",
     "id": "ID_2024_SUBCLASS_FEATURE_DRUID_CIRCLE_OF_THE_LAND_CIRCLE_OF_THE_LAND_SPELLS",
     "type": "Archetype Feature",
     "level": 3
    },
    {
     "kind": "grant",
     "id": "ID_2024_SUBCLASS_FEATURE_DRUID_CIRCLE_OF_THE_LAND_LANDS_AID",
     "type": "Archetype Feature",
     "level": 3
    },
    {
