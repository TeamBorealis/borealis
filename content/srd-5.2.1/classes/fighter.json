  {
   "id": "ID_2024_CLASS_FEATURE_FIGHTER_EXTRA_ATTACK",
   "name": "Extra Attack",
   "type": "Class Feature",
   "source": "SRD 5.2.1",
   "ruleset": "dnd2024",
   "description": "<p>You can attack twice instead of once whenever you take the Attack action on your turn.</p>",
