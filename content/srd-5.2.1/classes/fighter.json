  {
   "id": "ID_2024_CLASS_FEATURE_FIGHTER_TACTICAL_SHIFT",
   "name": "Tactical Shift",
   "type": "Class Feature",
   "source": "SRD 5.2.1",
   "ruleset": "dnd2024",
   "description": "<p>Whenever you activate your Second Wind with a Bonus Action, you can move up to half your Speed without provoking Opportunity Attacks.</p>",
   "data": {
    "class": "Fighter",
    "level": 5
   }
  },
  {
