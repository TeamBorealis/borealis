{
  "name": "borealis-e2e",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "e2e": "E2E_TELEMETRY_DISABLED=1 e2e run --target web",
    "e2e:replay": "E2E_TELEMETRY_DISABLED=1 e2e run --target web --strict-cache",
    "e2e:ci": "E2E_TELEMETRY_DISABLED=1 CI=1 e2e run --target web --strict-cache",
    "e2e:install": "E2E_TELEMETRY_DISABLED=1 e2e-web install chromium",
    "e2e:ios": "E2E_TELEMETRY_DISABLED=1 DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} e2e run --target ios --tag ios",
    "e2e:ios:replay": "E2E_TELEMETRY_DISABLED=1 DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} e2e run --target ios --tag ios --strict-cache",
    "e2e:android": "E2E_TELEMETRY_DISABLED=1 ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} e2e run --target android --tag android --pass-with-no-tests",
    "e2e:android:replay": "E2E_TELEMETRY_DISABLED=1 ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} e2e run --target android --tag android --pass-with-no-tests --strict-cache",
    "e2e:macos": "E2E_TELEMETRY_DISABLED=1 e2e run --target macos --tag macos",
    "e2e:macos:replay": "E2E_TELEMETRY_DISABLED=1 e2e run --target macos --tag macos --strict-cache",
    "tour:web": "E2E_TELEMETRY_DISABLED=1 E2E_TOUR=1 e2e run --target web --tag tour --output .e2e/tour-web --video=on",
    "tour:ios": "E2E_TELEMETRY_DISABLED=1 E2E_TOUR=1 DEVELOPER_DIR=${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer} e2e run --target ios --tag tour --output .e2e/tour-ios --video=on",
    "tour:android": "E2E_TELEMETRY_DISABLED=1 E2E_TOUR=1 ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} e2e run --target android --tag tour --output .e2e/tour-android --video=on",
    "tour:macos": "E2E_TELEMETRY_DISABLED=1 E2E_TOUR=1 e2e run --target macos --tag tour --output .e2e/tour-macos --video=on",
    "tour:collect": "node scripts/collect-videos.mjs"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@e2e-dev/mobile": "^0.11.0",
    "@e2e-dev/web": "0.14.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/node": "^26.6.5",
    "ai": "^7.0.137",
    "e2e": "0.19.0",
    "typescript": "^7.0.2"
  }
}
