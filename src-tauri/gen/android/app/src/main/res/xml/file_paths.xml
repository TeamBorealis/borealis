     "Share as a file" (read grant for the receiving app only). Nothing else of the app's storage has a
     content URI. Test: open_with_manifests.rs the_file_provider_serves_only_the_share_folder. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="share" path="share/" />
</paths>
