{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["dnd5e"],
        "name": "Borealis.Character",
        "description": "5e character",
        "role": "Editor",
        "mimeType": "application/x-dnd5e"
      },
      {
        "ext": ["index"],
        "name": "Borealis.ContentIndex",
        "description": "Content index",
        "role": "Viewer"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
