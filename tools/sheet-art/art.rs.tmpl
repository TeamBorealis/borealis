//! Borealis character-sheet art: vector path tables for the frame, corners, header flourish,
//! divider, ability sigils, hit-die and death-save glyphs and the borealis-ribbon watermark.
//!
//! GENERATED by `tools/sheet-art/build.mjs` (the geometry is drawn with anidoodle's portable core,
//! Apache-2.0). Do not edit the data by hand; edit the generator and re-run it. See tools/sheet-art/README.md.
//!
//! Two sets exist: [`ArtSet::Colour`] (the approved print palette) and [`ArtSet::Ink`] (pure black and
//! greys, richer detail, for the monochrome export mode). Both are renderer-agnostic: a PDF writer turns
//! [`ArtPath::ops`] into `m/l/c/h` operators (fill `f`, stroke `S`, alpha through an ExtGState), and
//! [`to_svg`] gives the same geometry to the HTML preview.
//!
//! Coordinates are y-down, in the piece's own units (`width` x `height`). Place a piece at scale `s`
//! (points per unit); fine strokes stay at or above 0.3 pt when `s >= nominal_scale`.
#![allow(dead_code)] // consumers (pdf_layout, html) arrive in later work packages
#![allow(clippy::approx_constant)] // generated coordinates may look like TAU etc.

/// 8-bit sRGB colour.
pub(crate) type Rgb = [u8; 3];

/// Stroke style; round caps and joins are always used.
#[derive(Debug, Clone, Copy, PartialEq)]
pub(crate) struct Stroke {
    pub rgb: Rgb,
    /// Line width in piece units.
    pub width: f32,
}

/// One path operation.
#[derive(Debug, Clone, Copy, PartialEq)]
pub(crate) enum Op {
    Move(f32, f32),
    Line(f32, f32),
    /// Cubic Bezier: control 1, control 2, end point.
    Cubic(f32, f32, f32, f32, f32, f32),
    Close,
}

/// A single paint: a path with a fill, a stroke or both, and an alpha for both.
#[derive(Debug, Clone, Copy)]
pub(crate) struct ArtPath {
    pub fill: Option<Rgb>,
    pub stroke: Option<Stroke>,
    /// 0.0..=1.0, applies to fill and stroke.
    pub alpha: f32,
    /// Packed ops: 0 = move (x y), 1 = line (x y), 2 = cubic (x1 y1 x2 y2 x y), 3 = close.
    data: &'static [f32],
}

impl ArtPath {
    /// Decoded path operations.
    pub fn ops(&self) -> OpIter {
        OpIter { data: self.data }
    }

    /// Number of packed numbers (a size measure).
    pub fn packed_len(&self) -> usize {
        self.data.len()
    }
}

/// Iterator over a path's [`Op`]s.
pub(crate) struct OpIter {
    data: &'static [f32],
}

impl Iterator for OpIter {
    type Item = Op;

    fn next(&mut self) -> Option<Op> {
        let (&tag, rest) = self.data.split_first()?;
        let (op, used) = match tag as u8 {
            0 => (Op::Move(rest[0], rest[1]), 2),
            1 => (Op::Line(rest[0], rest[1]), 2),
            2 => (
                Op::Cubic(rest[0], rest[1], rest[2], rest[3], rest[4], rest[5]),
                6,
            ),
            _ => (Op::Close, 0),
        };
        self.data = &rest[used..];
        Some(op)
    }
}

/// A drawable piece: paint in order, first path at the back.
#[derive(Debug, Clone, Copy)]
pub(crate) struct ArtPiece {
    pub width: f32,
    pub height: f32,
    /// Smallest recommended placement scale (points per unit).
    pub nominal_scale: f32,
    pub paths: &'static [ArtPath],
}

/// Which art set to draw.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub(crate) enum ArtSet {
    Colour,
    Ink,
}

/// Piece identifiers. Corner is drawn for the top-left; mirror it for the other three corners.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub(crate) enum ArtId {
//@@IDS@@
}

impl ArtId {
    pub const COUNT: usize = //@@COUNT@@;
    pub const ALL: [ArtId; Self::COUNT] = [
//@@ALL@@
    ];
}

/// The piece for `id` in `set`.
pub(crate) fn piece(set: ArtSet, id: ArtId) -> &'static ArtPiece {
    match set {
        ArtSet::Colour => &COLOUR_PIECES[id as usize],
        ArtSet::Ink => &INK_PIECES[id as usize],
    }
}

/// Smallest drawn line width, in points, when `piece` is placed at `scale` points per unit.
pub(crate) fn min_stroke_pt(piece: &ArtPiece, scale: f32) -> f32 {
    piece
        .paths
        .iter()
        .filter_map(|p| p.stroke.map(|s| s.width * scale))
        .fold(f32::INFINITY, f32::min)
}

/// SVG document for a piece (preview and HTML sheet).
pub(crate) fn to_svg(piece: &ArtPiece) -> String {
    use std::fmt::Write;
    let hex = |c: Rgb| format!("#{:02X}{:02X}{:02X}", c[0], c[1], c[2]);
    let mut out = format!(
        "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {} {}\">",
        piece.width, piece.height
    );
    for p in piece.paths {
        let mut d = String::new();
        for op in p.ops() {
            let _ = match op {
                Op::Move(x, y) => write!(d, "M{x} {y}"),
                Op::Line(x, y) => write!(d, "L{x} {y}"),
                Op::Cubic(a, b, c, e, x, y) => write!(d, "C{a} {b} {c} {e} {x} {y}"),
                Op::Close => write!(d, "Z"),
            };
        }
        let opacity = if p.alpha < 1.0 {
            format!(" opacity=\"{}\"", p.alpha)
        } else {
            String::new()
        };
        let _ = match (p.fill, p.stroke) {
            (Some(f), _) => write!(out, "<path d=\"{d}\" fill=\"{}\"{opacity}/>", hex(f)),
            (None, Some(s)) => write!(
                out,
                "<path d=\"{d}\" fill=\"none\" stroke=\"{}\" stroke-width=\"{}\" stroke-linecap=\"round\" stroke-linejoin=\"round\"{opacity}/>",
                hex(s.rgb),
                s.width
            ),
            (None, None) => Ok(()),
        };
    }
    out.push_str("</svg>");
    out
}

//@@DATA@@
#[cfg(test)]
mod tests {
    use super::*;

    const SETS: [ArtSet; 2] = [ArtSet::Colour, ArtSet::Ink];
    /// (path count, packed numbers) per set, written by the generator.
    const GOLDEN_COUNTS: [(usize, usize); 2] = //@@GOLDEN@@;

    fn coords(path: &ArtPath) -> Vec<(f32, f32)> {
        path.ops()
            .flat_map(|op| match op {
                Op::Move(x, y) | Op::Line(x, y) => vec![(x, y)],
                Op::Cubic(a, b, c, d, x, y) => vec![(a, b), (c, d), (x, y)],
                Op::Close => vec![],
            })
            .collect()
    }

    #[test]
    fn every_coordinate_is_finite_and_inside_the_view_box() {
        for set in SETS {
            for id in ArtId::ALL {
                let piece = piece(set, id);
                for path in piece.paths {
                    let half = path.stroke.map_or(0.0, |s| s.width / 2.0);
                    for (x, y) in coords(path) {
                        assert!(x.is_finite() && y.is_finite(), "{set:?}/{id:?} has a non-finite coordinate");
                        assert!(
                            x >= -half - 0.5 && x <= piece.width + half + 0.5 && y >= -half - 0.5 && y <= piece.height + half + 0.5,
                            "{set:?}/{id:?} point ({x}, {y}) is outside {}x{}",
                            piece.width,
                            piece.height
                        );
                    }
                }
            }
        }
    }

    #[test]
    fn every_path_is_painted_and_well_formed() {
        for set in SETS {
            for id in ArtId::ALL {
                for path in piece(set, id).paths {
                    assert!(path.fill.is_some() || path.stroke.is_some(), "{set:?}/{id:?} has an unpainted path");
                    assert!((0.0..=1.0).contains(&path.alpha) && path.alpha > 0.0);
                    assert!(matches!(path.ops().next(), Some(Op::Move(..))), "{set:?}/{id:?} does not start with a move");
                }
            }
        }
    }

    #[test]
    fn fine_lines_stay_print_safe_at_nominal_scale() {
        for set in SETS {
            for id in ArtId::ALL {
                let piece = piece(set, id);
                let min = min_stroke_pt(piece, piece.nominal_scale);
                assert!(min >= 0.29, "{set:?}/{id:?} has a {min:.2} pt line at nominal scale");
            }
        }
    }

    #[test]
    fn ink_set_is_strictly_monochrome() {
        for id in ArtId::ALL {
            for path in piece(ArtSet::Ink, id).paths {
                let colours = path.fill.into_iter().chain(path.stroke.map(|s| s.rgb));
                for c in colours {
                    assert!(c[0] == c[1] && c[1] == c[2], "{id:?} uses a non-grey colour {c:?}");
                }
            }
        }
    }

    #[test]
    fn ink_set_is_richer_than_colour_for_the_ornaments() {
        for id in [ArtId::Corner, ArtId::FrameLetter, ArtId::SigilStr, ArtId::SigilWis, ArtId::Divider] {
            let count = |set| piece(set, id).paths.iter().map(ArtPath::packed_len).sum::<usize>();
            assert!(count(ArtSet::Ink) > count(ArtSet::Colour), "{id:?} ink is not richer");
        }
    }

    #[test]
    fn path_counts_and_size_are_stable() {
        // Golden numbers: update deliberately when the art changes.
        let counts: Vec<(usize, usize)> = SETS
            .iter()
            .map(|&s| {
                let all = ArtId::ALL.iter().map(|&id| piece(s, id));
                (all.clone().map(|p| p.paths.len()).sum(), all.flat_map(|p| p.paths).map(ArtPath::packed_len).sum())
            })
            .collect();
        assert_eq!(counts, GOLDEN_COUNTS, "regenerate and review, then update GOLDEN_COUNTS");
        assert!(counts[0].1 * 4 < 60_000 && counts[1].1 * 4 < 120_000, "table size budget exceeded");
    }

    #[test]
    fn svg_output_is_well_formed() {
        let svg = to_svg(piece(ArtSet::Colour, ArtId::SigilStr));
        assert!(svg.starts_with("<svg") && svg.ends_with("</svg>") && !svg.contains("NaN"));
    }
}
